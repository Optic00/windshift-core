# windshift-runner configuration (environment file for the systemd unit).
# Copy to /etc/windshift-runner/runner.env and fill in the REQUIRED values.
# install.sh installs this template if no runner.env exists yet.

# --- REQUIRED ---------------------------------------------------------------

# Orchestrator base URL ending in /api — the runner control plane and brokers
# live there (POST /api/runner/register, /api/git-proxy/...). This is NOT the
# scoped v1 REST API (/rest/api/v1) and NOT the bare host — it must be /api.
WS_API_URL=https://windshift.example.com/api

# Pool registration token (wsrt_…) minted by a workspace admin for the runner
# pool this host should join. One-time bootstrap secret; the runner exchanges
# it for a per-instance credential on first start. Treat as a secret.
WSRUNNER_REGISTRATION_TOKEN=wsrt_replace_me

# Coding-agent container image the runner spawns per job. Must be pullable by
# the local docker daemon (or already present). This is the thin no-node
# windshift-agent image.
WSRUNNER_IMAGE=ghcr.io/windshiftapp/windshift-agent:latest

# --- OPTIONAL (sensible defaults shown) -------------------------------------

# Display name for this runner instance (defaults to the hostname).
#WSRUNNER_NAME=runner-1

# docker binary (defaults to "docker").
#WSRUNNER_DOCKER=docker

# windshift-triage binary the runner execs for git prep/push. install.sh sets
# this to the installed path; the default assumes it is on PATH.
WSRUNNER_TRIAGE_BIN=/usr/local/bin/windshift-triage

# Host-local bare-clone cache root (fetch accelerator). Must be writable by the
# runner's user. NEVER mounted into a container.
WSRUNNER_CACHE_ROOT=/var/lib/windshift-runner/cache

# Claim poll interval when idle (Go duration; default 2s).
#WSRUNNER_POLL_INTERVAL=2s

# Lease heartbeat interval (Go duration; default 30s).
#WSRUNNER_HEARTBEAT_INTERVAL=30s

# Optional emergency fallback only. Normal coding-agent jobs carry the
# server-managed prompt in JobSpec.initial_prompt.
#WSRUNNER_INITIAL_PROMPT=

# Accept an agent image without the org.windshift.agent-contract label
# (only needed for windshift-agent images built before the label existed).
#WSRUNNER_ALLOW_UNLABELED_IMAGE=1
