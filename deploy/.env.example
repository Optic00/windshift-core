# Windshift Environment Configuration
# Copy this file to .env and configure your settings
# Run ./init.sh to automatically generate SSO_SECRET

# =============================================================================
# Required Settings
# =============================================================================

# Domain where Windshift will be accessible (without protocol)
DOMAIN=windshift.example.com

# Host port to expose (default: 8080)
# PORT=8080

# Secret key for SSO authentication (auto-generated by init.sh)
# Generate manually with: openssl rand -hex 32
SSO_SECRET=

# =============================================================================
# PostgreSQL Settings (uncomment when using PostgreSQL instead of SQLite)
# =============================================================================

# POSTGRES_PASSWORD=your-secure-password-here

# Per-replica main application pool (default: 30).
# MAX_READ_CONNS=30

# Number of Windshift containers sharing this PostgreSQL server (default: 1).
# POSTGRES_REPLICA_COUNT=1

# Connections reserved outside Windshift for migrations, administration, and
# other clients (default: 10). Required capacity is:
# replicas × (MAX_READ_CONNS + 5 when SSH is enabled) + headroom.
# POSTGRES_CONNECTION_HEADROOM=10

# =============================================================================
# Traefik Settings (uncomment when using built-in Traefik reverse proxy)
# =============================================================================

# Email for Let's Encrypt certificate notifications
# LETSENCRYPT_EMAIL=admin@example.com

# =============================================================================
# LLM Settings (uncomment when using local AI inference)
# =============================================================================

# Number of CPU threads for LLM inference (default: 4)
# LLM_THREADS=4
