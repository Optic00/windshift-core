{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "frontend/src/main.js",
    "frontend/svelte.config.js"
  ],
  "ignorePatterns": [
    "frontend/src/design-system/**",
    "frontend/design-system.html",
    "frontend/public/**",
    "frontend/scripts/**",
    "plugin-src/**"
  ],
  "ignoreUnresolvedImports": [
    "@fontsource/inter/latin.css",
    "@xterm/xterm/css/xterm.css"
  ],
  "ignoreExports": [
    { "file": "frontend/src/**/*.svelte", "exports": ["*"] }
  ],
  "dynamicallyLoaded": [
    "frontend/src/lib/locales/**/*.js"
  ],
  "rules": {}
}
