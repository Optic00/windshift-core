{%- if fault != '' -%}
{% render 'notice', headline: 'Windshift', detail: fault %}
{%- else -%}
<div class="layout layout--col gap--small">
  <div class="grid grid--cols-2">
    {% render 'stat', number: open_total,      caption: 'Open',         size: 'large' %}
    {% render 'stat', number: due_today_count, caption: 'Due today',    size: 'large' %}
    {% render 'stat', number: overdue_count,   caption: 'Overdue',      size: 'large' %}
    {% render 'stat', number: closed_today,    caption: 'Closed today', size: 'large' %}
  </div>

  <span class="label label--underline">Next up</span>
  {%- if next_up -%}
    <div class="item">
      <div class="content">
        <span class="title title--small" data-clamp="2">{{ next_up.title }}</span>
        <span class="label label--small">{{ next_up.key }}</span>
      </div>
    </div>
  {%- else -%}
    <span class="description">Nothing open</span>
  {%- endif -%}
</div>
{%- endif -%}

<div class="title_bar">
  <span class="title">Windshift</span>
  {%- if fault == '' -%}<span class="instance">{{ 'now' | date: '%a, %-d %b' }}</span>{%- endif -%}
</div>
